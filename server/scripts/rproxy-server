#!/bin/bash
# ============================================================================
# rproxy-server: RProxy 服务端命令行管理工具
# 安装位置：/usr/local/bin/rproxy-server
# ============================================================================

set -e

source /opt/rproxy-server/scripts/common.sh

require_installed() {
    is_installed || die "RProxy 服务端 未安装"
}

# 存在即关闭 Xray 自动更新（update-daemon.sh 读取），手动升级不受影响
NO_XRAY_AUTO_UPDATE_FILE="/var/lib/rproxy-server/no-xray-auto-update"

# ============================================================================
# 内部：渲染 Xray 配置
# ============================================================================

_render_xray() {
    require_installed
    local uuid ws_path
    uuid=$(json_get "${SERVER_CFG}" '.uuid')
    ws_path=$(json_get "${SERVER_CFG}" '.ws_path')

    [[ -n "$uuid" && -n "$ws_path" ]] || die "server.json 不完整"

    mkdir -p /usr/local/etc/xray
    # 临时文件必须以 .json 结尾：Xray v26.10.21 起按扩展名识别格式，.tmp 会被拒绝（-format=json 也无效）
    local tmp="${XRAY_CONFIG_FILE%.json}.tmp.json"
    _render_xray_to "$uuid" "$ws_path" "$tmp" || return 1
    mv "$tmp" "${XRAY_CONFIG_FILE}"
}

# _render_xray_to <uuid> <路径> <输出文件>：生成 Xray 配置并用 xray -test 校验，不通过时删掉输出文件并返回 1
_render_xray_to() {
    local uuid="$1" ws_path="$2" tmp="$3"
    cat > "$tmp" <<EOF
{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "vless-xhttp",
      "listen": "127.0.0.1",
      "port": ${XRAY_XHTTP_PORT},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${uuid}",
            "email": "default@local"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "${ws_path}",
          "mode": "auto"
        }
      }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "block",  "protocol": "blackhole" }
  ],
  "routing": {
    "rules": [
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "block" }
    ]
  }
}
EOF

    # 验证：用 -format=json 显式指定格式
    if ! xray run -test -format=json -c "$tmp" >/dev/null 2>&1; then
        log_error "渲染的 Xray 配置语法错误"
        xray run -test -format=json -c "$tmp" 2>&1
        rm -f "$tmp"
        return 1
    fi
}

_apply_xray() {
    _render_xray
    restart_service xray
}

# ============================================================================
# status：查看状态
# ============================================================================

cmd_status() {
    require_installed
    local domain ws_path uuid
    domain=$(json_get "${SERVER_CFG}" '.domain')
    ws_path=$(json_get "${SERVER_CFG}" '.ws_path')
    uuid=$(json_get "${SERVER_CFG}" '.uuid')

    echo ""
    echo -e "  ${CYAN}RProxy 服务端 状态${NC}"
    echo "  ────────────────────────────────────────────────"
    echo -e "  版本：           $(get_installed_version)"
    if is_service_active xray; then
        echo -e "  Xray 状态：      ${GREEN}运行中${NC}"
    else
        echo -e "  Xray 状态：      ${RED}未运行${NC}"
    fi
    if is_service_active nginx; then
        echo -e "  Nginx 状态：     ${GREEN}运行中${NC}"
    else
        echo -e "  Nginx 状态：     ${RED}未运行${NC}"
    fi
    local public_ip
    public_ip=$(get_public_ip)
    echo -e "  公网 IP：        ${CYAN}${public_ip:-未知}${NC}"
    echo -e "  域名：           ${CYAN}${domain}${NC}"
    echo -e "  监听端口：       ${CYAN}443${NC}"
    echo -e "  WS 路径：        ${ws_path}"
    echo -e "  UUID：           ${uuid}"
    echo ""

    # 证书有效期
    if [[ -f "${SSL_DIR}/server.crt" ]]; then
        local cert_expire
        cert_expire=$(openssl x509 -in "${SSL_DIR}/server.crt" -noout -enddate 2>/dev/null | sed 's/notAfter=//')
        echo -e "  证书到期：       ${cert_expire}"
    fi

    if is_service_active rproxy-server-update.timer; then
        local next_run
        next_run=$(systemctl list-timers rproxy-server-update.timer --no-pager 2>/dev/null | awk 'NR==2 {print $1, $2}')
        echo -e "  下次自动更新：   ${next_run:-未知}"
    fi
    if [[ -f "$NO_XRAY_AUTO_UPDATE_FILE" ]]; then
        echo -e "  Xray 自动更新：  ${YELLOW}已关闭${NC}"
    else
        echo -e "  Xray 自动更新：  已开启"
    fi
    echo ""
}

# ============================================================================
# show：显示客户端配置
# ============================================================================

cmd_show() {
    require_installed
    local domain ws_path uuid
    domain=$(json_get "${SERVER_CFG}" '.domain')
    ws_path=$(json_get "${SERVER_CFG}" '.ws_path')
    uuid=$(json_get "${SERVER_CFG}" '.uuid')

    echo ""
    echo -e "  ${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "  ${GREEN}客户端配置${NC}"
    echo -e "  ${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
    echo "  把以下字段填到 RProxy 客户端 WebUI 的【节点管理】→【+ 添加节点】："
    echo ""
    printf "    %-20s %s\n"             "名称（自定义）："    "如：MyVPS"
    printf "    %-20s ${CYAN}%s${NC}\n" "协议："           "VLESS + XHTTP + TLS"
    printf "    %-20s ${CYAN}%s${NC}\n" "地址 (address)：" "${domain}"
    printf "    %-20s ${CYAN}%s${NC}\n" "端口 (port)："    "443"
    printf "    %-20s ${CYAN}%s${NC}\n" "UUID："           "${uuid}"
    printf "    %-20s ${CYAN}%s${NC}\n" "路径："           "${ws_path}"
    printf "    %-20s ${CYAN}%s${NC}\n" "SNI / Host："     "${domain}"
    echo ""
    echo -e "  ${CYAN}═══════════════════════════════════════════════════════════════${NC}"
    echo ""
}

# ============================================================================
# change-domain：更换域名（重新申请证书）
# ============================================================================

cmd_change_domain() {
    require_installed
    require_root
    local new_domain="$1"
    [[ -n "$new_domain" ]] || die "用法: rproxy-server change-domain <新域名>"

    local old_domain
    old_domain=$(json_get "${SERVER_CFG}" '.domain')
    log_info "当前域名：${old_domain}    新域名：${new_domain}"
    log_warn "切换前请确认新域名已经解析到本机 IP"

    local confirm
    confirm=$(ask "确认切换？(yes/no): " "no")
    [[ "$confirm" == "yes" ]] || { log_info "已取消"; return; }

    # 申请新证书
    log_step "申请新证书"
    if ! "${ACME_HOME}/acme.sh" --issue \
            -d "${new_domain}" \
            -w "${WEB_ROOT}" \
            -k ec-256 \
            --force; then
        log_error "新域名证书申请失败，未做任何更改"
        return 1
    fi
    "${ACME_HOME}/acme.sh" --installcert -d "${new_domain}" \
        --ecc \
        --key-file       "${SSL_DIR}/server.key" \
        --fullchain-file "${SSL_DIR}/server.crt" \
        --reloadcmd      "systemctl reload nginx"

    # 更新配置
    json_set "${SERVER_CFG}" ".domain = \"${new_domain}\""

    # 重新部署 Nginx
    DOMAIN="${new_domain}"
    local ws_path
    ws_path=$(json_get "${SERVER_CFG}" '.ws_path')
    sed -i \
        -e "s|server_name ${old_domain};|server_name ${new_domain};|g" \
        "${NGINX_CONF}"

    # 也可能需要重新生成完整 nginx 配置（更稳）
    deploy_final_nginx_inplace

    # 旧域名的续期还在 acme.sh 里，且同样安装到 server.crt：续期成功时会用旧域名证书覆盖新证书
    _remove_stale_acme_domains "${new_domain}"

    log_done "域名已切换到 ${new_domain}"
    log_warn "请用新的域名更新所有客户端配置！"
}

# 撤销其他域名写到本机证书路径（${SSL_DIR}/server.crt）的自动续期，只保留 <当前域名>。
# acme.sh 的 --remove 只停止续期、不删证书文件；安装到别的路径的证书（本机其他站点）不受影响
_remove_stale_acme_domains() {
    local current="$1" conf d path
    [[ -n "$current" && -d "${ACME_HOME}" ]] || return 0
    for conf in "${ACME_HOME}"/*/*.conf; do
        [[ -f "$conf" && "$conf" != *.csr.conf ]] || continue
        # 新版 acme.sh 写成 Key='value'，旧版不带引号
        d=$(sed -n "s/^Le_Domain=['\"]\{0,1\}\([^'\"]*\)['\"]\{0,1\}\$/\1/p" "$conf" | head -n 1)
        path=$(sed -n "s/^Le_RealFullChainPath=['\"]\{0,1\}\([^'\"]*\)['\"]\{0,1\}\$/\1/p" "$conf" | head -n 1)
        [[ -n "$d" && "$d" != "$current" && "$path" == "${SSL_DIR}/server.crt" ]] || continue
        log_info "撤销旧域名 ${d} 的证书自动续期（避免覆盖当前域名 ${current} 的证书）"
        if [[ "$(dirname "$conf")" == *_ecc ]]; then
            "${ACME_HOME}/acme.sh" --remove -d "$d" --ecc || log_warn "撤销 ${d} 失败"
        else
            "${ACME_HOME}/acme.sh" --remove -d "$d" || log_warn "撤销 ${d} 失败"
        fi
    done
}

# 工具：用源码模板重新渲染 nginx；可传入 XHTTP 路径（regenerate 在写入 server.json 之前先用新路径渲染校验），
# 不传则用 server.json 里的路径
deploy_final_nginx_inplace() {
    local domain ws_path
    domain=$(json_get "${SERVER_CFG}" '.domain')
    ws_path="${1:-$(json_get "${SERVER_CFG}" '.ws_path')}"

    # 用已部署的脚本目录里的模板
    local tpl="${SCRIPTS_DIR}/nginx-template.conf"
    if [[ ! -f "$tpl" ]]; then
        log_warn "找不到 nginx 模板，仅替换 server_name"
        return
    fi
    # 只改本项目自己的配置文件，但 nginx -t 查的是整个 nginx：用户自己的站点配置（如反代 Vaultwarden）已有错误时不动手，
    # 否则 reload 失败，用户会误以为是本工具弄坏的（regenerate 还会因此让 Xray 与 nginx 的路径不一致）
    if ! nginx_config_clean; then
        log_error "检测到 nginx 当前配置就有错误（不是本项目的文件），未做任何改动。请先执行 nginx -t 查看并修复后重试"
        return 1
    fi

    # 先备份，nginx -t 不通过就恢复（同 install.sh 的 deploy_final_nginx）
    local bak="${NGINX_CONF}.bak"
    cp -f "${NGINX_CONF}" "$bak"

    render_nginx_conf "$tpl" "$domain" "$ws_path" > "${NGINX_CONF}"

    if ! nginx -t; then
        mv -f "$bak" "${NGINX_CONF}"
        log_error "新 Nginx 配置语法错误，已恢复为原配置"
        return 1
    fi
    rm -f "$bak"
    systemctl reload nginx
}

# ============================================================================
# regenerate：重新生成 UUID 和 WS 路径
# ============================================================================

cmd_regenerate() {
    require_installed
    require_root
    # 没有模板就无法改 nginx 的路径，Xray 与 nginx 路径不一致会让所有客户端断线
    [[ -f "${SCRIPTS_DIR}/nginx-template.conf" ]] \
        || die "找不到 nginx 模板 ${SCRIPTS_DIR}/nginx-template.conf，无法重新生成（可先执行 rproxy-server upgrade 补齐）"
    log_warn "这将重新生成 UUID 和 WS 路径，所有现有客户端需要更新配置！"
    local confirm
    confirm=$(ask "确认继续？(yes/no): " "no")
    [[ "$confirm" == "yes" ]] || { log_info "已取消"; return; }

    local new_uuid new_ws_path tmp
    new_uuid=$(xray uuid)
    new_ws_path="/$(openssl rand -hex 8)"

    # 先生成并校验新的 Xray 与 nginx 配置，都通过后才生效：任何一步失败都保持原样。
    # 不能先写 server.json：校验失败后 Xray 与 nginx 的路径会对不上，之后 Xray 一重启所有客户端就断线
    mkdir -p /usr/local/etc/xray
    tmp="${XRAY_CONFIG_FILE%.json}.tmp.json"
    _render_xray_to "$new_uuid" "$new_ws_path" "$tmp" || die "新 Xray 配置校验失败，未做任何更改"
    if ! deploy_final_nginx_inplace "$new_ws_path"; then
        rm -f "$tmp"
        die "新 Nginx 配置校验失败，未做任何更改"
    fi
    # nginx 已切到新路径：启用新的 Xray 配置、记录到 server.json，再重启 Xray
    mv "$tmp" "${XRAY_CONFIG_FILE}"
    json_set "${SERVER_CFG}" \
        ".uuid = \"${new_uuid}\" | .ws_path = \"${new_ws_path}\""
    restart_service xray

    log_done "已重新生成 UUID 和 WS 路径"
    cmd_show
}

# ============================================================================
# fw：防火墙端口管理
# ============================================================================

cmd_fw() {
    require_installed
    case "${1:-list}" in
        list) cmd_fw_list ;;
        add)  cmd_fw_add  "$2" "${3:-tcp}" ;;
        del)  cmd_fw_del  "$2" "${3:-tcp}" ;;
        *)
            cat <<EOF
用法：
  rproxy-server fw list                 列出当前防火墙规则
  rproxy-server fw add <port> [tcp|udp] 放行端口（默认 tcp）
  rproxy-server fw del <port> [tcp|udp] 撤销放行
EOF
            ;;
    esac
}

cmd_fw_list() {
    if ! is_service_active nftables; then
        log_warn "nftables 未启用（你可能选择了不使用本地防火墙，由云厂商安全组管理）"
        return
    fi
    echo ""
    nft list ruleset
    echo ""
}

# 把防火墙规则写回 /etc/nftables.conf：只导出本工具管理的 inet filter 表（与安装时生成的文件结构一致），
# 不把其他软件（如 Docker、fail2ban）的规则和动态内容一起固化进去；先写临时文件再改名，断电不会留下半个文件
_save_fw_rules() {
    local tmp=/etc/nftables.conf.tmp
    {
        echo '#!/usr/sbin/nft -f'
        echo 'flush ruleset'
        nft list table inet filter
    } > "$tmp" || { rm -f "$tmp"; die "导出防火墙规则失败，/etc/nftables.conf 未改动"; }
    mv -f "$tmp" /etc/nftables.conf
}

cmd_fw_add() {
    local port="$1" proto="${2:-tcp}"
    [[ "$port" =~ ^[0-9]+$ ]] || die "无效端口"
    [[ "$proto" == "tcp" || "$proto" == "udp" ]] || die "协议只能是 tcp 或 udp"
    is_service_active nftables || die "nftables 未启用"
    nft add rule inet filter input ${proto} dport ${port} accept comment "\"user-added\""
    _save_fw_rules
    log_done "已放行 ${port}/${proto}"
}

cmd_fw_del() {
    local port="$1" proto="${2:-tcp}"
    [[ "$port" =~ ^[0-9]+$ ]] || die "无效端口"
    is_service_active nftables || die "nftables 未启用"
    local handle
    handle=$(nft -a list chain inet filter input 2>/dev/null | \
        awk -v p="$port" -v pr="$proto" '$0 ~ pr " dport " p " " {print $NF}' | head -1)
    [[ -n "$handle" ]] || { log_warn "未找到匹配规则"; return; }
    nft delete rule inet filter input handle "$handle"
    _save_fw_rules
    log_done "已删除规则 ${port}/${proto}"
}

# ============================================================================
# logs：查看日志
# ============================================================================

cmd_logs() {
    local component="${1:-xray}"
    local lines="${2:-100}"
    [[ "$lines" =~ ^[0-9]+$ ]] || lines=100

    local unit
    case "$component" in
        xray)   unit="xray" ;;
        nginx)  unit="nginx" ;;
        update) unit="rproxy-server-update" ;;
        *)
            cat <<EOF
用法：rproxy-server logs [xray|nginx|update] [行数]
EOF
            return
            ;;
    esac
    journalctl -u "$unit" --no-pager -n "$lines"
}

# ============================================================================
# upgrade / uninstall
# ============================================================================

cmd_upgrade() {
    require_root
    # 优先用 GitHub 上最新 Release 对应 tag 的 install.sh 与 common.sh（与每日更新一致，不取 main 上未发布的脚本）；
    # 下载失败时由用户决定是否改用本机保存的 install.sh（安装或上次升级时留下的，可能较旧），默认不用。
    # 选定一份脚本后只运行这一份：它失败退出（含"自检不通过、已自动回滚"）时不再换另一份脚本重新升级
    local tag tmp_dir reason rc=0
    tag=$(get_latest_release_tag)
    if [[ -n "$tag" ]]; then
        local raw="https://raw.githubusercontent.com/${REPO_SLUG}/${tag}/server"
        tmp_dir=$(mktemp -d)
        mkdir -p "${tmp_dir}/scripts"
        if curl -fsSL --max-time 60 "${raw}/install.sh" -o "${tmp_dir}/install.sh" \
            && curl -fsSL --max-time 60 "${raw}/scripts/common.sh" -o "${tmp_dir}/scripts/common.sh"; then
            bash "${tmp_dir}/install.sh" upgrade "$tag" || rc=$?
            rm -rf "$tmp_dir"
            return $rc
        fi
        rm -rf "$tmp_dir"
        reason="从 GitHub 下载 ${tag} 的升级脚本失败"
    else
        reason="无法从 GitHub 查询最新版本"
    fi

    log_warn "${reason}（请检查网络，必要时先 export https_proxy=http://代理:端口 再试）"
    [[ -f /opt/rproxy-server/install.sh ]] || die "本机也没有保存的 install.sh，无法升级"
    local ans
    ans=$(ask "是否改用本机保存的 install.sh（安装或上次升级时留下的，可能较旧）继续升级？(yes/no) [默认 no]: " "no")
    if [[ "$ans" != "yes" ]]; then
        log_info "已取消升级，系统未做任何改动"
        return 0
    fi
    bash /opt/rproxy-server/install.sh upgrade
}

# xray-autoupdate [on|off]：开关 Xray 自动更新，不带参数显示当前状态
cmd_xray_autoupdate() {
    require_installed
    case "${1:-}" in
        on)
            require_root
            rm -f "$NO_XRAY_AUTO_UPDATE_FILE"
            log_info "Xray 自动更新已开启"
            ;;
        off)
            require_root
            mkdir -p "$(dirname "$NO_XRAY_AUTO_UPDATE_FILE")"
            touch "$NO_XRAY_AUTO_UPDATE_FILE"
            log_info "Xray 自动更新已关闭（RProxy 自身升级、证书续期不受影响；手动 upgrade 仍会升级 Xray）"
            ;;
        "")
            if [[ -f "$NO_XRAY_AUTO_UPDATE_FILE" ]]; then
                echo "Xray 自动更新：已关闭"
            else
                echo "Xray 自动更新：已开启"
            fi
            ;;
        *)
            echo "用法：rproxy-server xray-autoupdate [on|off]"
            exit 1
            ;;
    esac
}

cmd_uninstall() {
    require_root
    if [[ -f /opt/rproxy-server/install.sh ]]; then
        bash /opt/rproxy-server/install.sh uninstall
    else
        bash <(curl -fsSL "${RAW_URL}/install.sh") uninstall
    fi
}

# ============================================================================
# help
# ============================================================================

cmd_help() {
    cat <<EOF

  ${CYAN}RProxy 服务端 管理工具${NC}

  用法：
    rproxy-server [命令]

  命令：
    status                          查看运行状态
    show                            显示客户端配置（用于客户端导入）
    change-domain <新域名>          切换域名（重新申请证书）
    regenerate                      重新生成 UUID 和 WS 路径
    fw list                         查看防火墙规则
    fw add <port> [tcp|udp]         放行端口
    fw del <port> [tcp|udp]         撤销放行
    logs [xray|nginx|update] [行数] 查看日志，默认 xray 100 行
    upgrade                         手动升级
    xray-autoupdate [on|off]        开关 Xray 自动更新，不带参数查看状态
    optimize                        系统优化（内核切换、网络调优）
    site import <zip 或目录>        导入自己的网站（先备份原网站，升级时不会被覆盖）
    site reset                      恢复为默认网站（先备份当前网站）
    uninstall                       卸载
    help                            显示此帮助

  不带参数运行时显示交互菜单。

EOF
}

# ============================================================================
# 交互菜单
# ============================================================================

show_menu() {
    while true; do
        clear
        echo ""
        echo -e "  ${CYAN}╔═══════════════════════════════════════════════════════════════╗${NC}"
        echo -e "  ${CYAN}║          RProxy 服务端 管理面板                               ║${NC}"
        echo -e "  ${CYAN}║          VLESS + XHTTP + TLS + 真网站                         ║${NC}"
        echo -e "  ${CYAN}╚═══════════════════════════════════════════════════════════════╝${NC}"
        echo ""

        # 远程版本（GitHub）
        local remote_ver
        remote_ver=$(get_remote_version)
        echo -e "    最新版本（GitHub）：${CYAN}${remote_ver}${NC}"

        if is_installed; then
            local local_ver domain
            local_ver=$(get_installed_version)
            domain=$(json_get "${SERVER_CFG}" '.domain')
            if [[ "$remote_ver" != "获取失败" && "$local_ver" != "$remote_ver" ]]; then
                echo -e "    当前已安装版本：  ${YELLOW}${local_ver}${NC}  ${YELLOW}（有新版可升级）${NC}"
            else
                echo -e "    当前已安装版本：  ${GREEN}${local_ver}${NC}"
            fi
            if is_service_active xray && is_service_active nginx; then
                echo -e "    服务状态：        ${GREEN}✅ 运行中${NC}"
            else
                echo -e "    服务状态：        ${RED}❌ 异常${NC}"
            fi
            echo -e "    域名：            ${domain}"
        else
            echo -e "    ${YELLOW}RProxy 服务端 未安装${NC}"
        fi
        echo ""
        echo "    1) 查看详细状态"
        echo "    2) 显示客户端配置"
        echo "    3) 切换域名（重新申请证书）"
        echo "    4) 重新生成 UUID 和 WS 路径"
        echo "    5) 防火墙端口管理"
        echo "    6) 查看 Xray 日志"
        echo "    7) 查看 Nginx 日志"
        echo "    8) 升级"
        echo "    9) 系统优化（内核、网络调优）"
        echo "   10) 卸载"
        if [[ -f "$NO_XRAY_AUTO_UPDATE_FILE" ]]; then
            echo -e "   11) Xray 自动更新开关（当前：${YELLOW}已关闭${NC}）"
        else
            echo "   11) Xray 自动更新开关（当前：已开启）"
        fi
        echo "    0) 退出"
        echo ""
        local choice
        choice=$(ask "    请选择: ")
        echo ""
        case "$choice" in
            1) cmd_status; press_enter ;;
            2) cmd_show; press_enter ;;
            3) menu_change_domain ;;
            4) cmd_regenerate; press_enter ;;
            5) menu_fw ;;
            6) cmd_logs xray 50; press_enter ;;
            7) cmd_logs nginx 50; press_enter ;;
            8) cmd_upgrade; press_enter ;;
            9) cmd_optimize ;;
            10) cmd_uninstall; exit 0 ;;
            11) menu_xray_autoupdate; press_enter ;;
            0) exit 0 ;;
            *) log_error "无效选项"; sleep 1 ;;
        esac
    done
}

press_enter() {
    echo ""
    local _
    _=$(ask "    按 Enter 继续...")
}

# 菜单：切换 Xray 自动更新（当前开启则关闭，反之亦然）
menu_xray_autoupdate() {
    if [[ -f "$NO_XRAY_AUTO_UPDATE_FILE" ]]; then
        cmd_xray_autoupdate on
    else
        cmd_xray_autoupdate off
    fi
}

menu_change_domain() {
    local current
    current=$(json_get "${SERVER_CFG}" '.domain')
    echo "    当前域名：${current}"
    echo ""
    local new_domain
    new_domain=$(ask "    输入新域名（确保已解析到本机 IP，回车取消）: ")
    [[ -n "$new_domain" ]] && cmd_change_domain "$new_domain"
    press_enter
}

menu_fw() {
    cmd_fw_list
    echo "    1) 添加放行端口"
    echo "    2) 删除放行端口"
    echo "    0) 返回"
    local c
    c=$(ask "    请选择: ")
    case "$c" in
        1) local p pr
           p=$(ask "    端口号: ")
           pr=$(ask "    协议 (tcp/udp，默认 tcp): " "tcp")
           [[ -n "$p" ]] && cmd_fw_add "$p" "$pr"
           press_enter ;;
        2) local p pr
           p=$(ask "    端口号: ")
           pr=$(ask "    协议 (tcp/udp，默认 tcp): " "tcp")
           [[ -n "$p" ]] && cmd_fw_del "$p" "$pr"
           press_enter ;;
        *) ;;
    esac
}

cmd_optimize() {
    local opt_script="${INSTALL_DIR}/scripts/system-optimize.sh"
    if [[ ! -f "$opt_script" ]]; then
        die "找不到 ${opt_script}"
    fi
    # shellcheck disable=SC1090
    source "$opt_script"
    system_optimize_menu
}

# ============================================================================
# 网站：导入自己的网站 / 恢复默认网站
# ============================================================================

cmd_site() {
    require_installed
    require_root
    # shellcheck disable=SC1091
    source "${SCRIPTS_DIR}/site.sh"
    local tpl="${INSTALL_DIR}/site-template"
    case "${1:-}" in
        import)
            [[ -n "${2:-}" ]] || die "用法：rproxy-server site import <zip 文件或网站目录>"
            site_import "$2"
            ;;
        reset)
            [[ -d "$tpl" ]] || die "找不到默认网站模板 ${tpl}（可先执行 rproxy-server upgrade 补齐）"
            local confirm
            confirm=$(ask "将用新的随机默认网站替换当前网站（原网站会先备份）。确认？(yes/no): " "no")
            [[ "$confirm" == "yes" ]] || { log_info "已取消"; return; }
            site_reset "$tpl"
            ;;
        *)
            die "用法：rproxy-server site import <zip 文件或网站目录> | site reset"
            ;;
    esac
}

# ============================================================================
# 入口
# ============================================================================

main() {
    case "${1:-}" in
        status)         cmd_status ;;
        show)           cmd_show ;;
        change-domain)  shift; cmd_change_domain "$@" ;;
        regenerate)     cmd_regenerate ;;
        fw)             shift; cmd_fw "$@" ;;
        logs)           shift; cmd_logs "$@" ;;
        upgrade)        cmd_upgrade ;;
        xray-autoupdate) shift; cmd_xray_autoupdate "$@" ;;
        optimize)       cmd_optimize ;;
        site)           shift; cmd_site "$@" ;;
        uninstall)      cmd_uninstall ;;
        help|-h|--help) cmd_help ;;
        _render-xray)   _render_xray ;;       # 内部使用
        _acme-cleanup)  require_installed; _remove_stale_acme_domains "$(json_get "${SERVER_CFG}" '.domain')" ;;  # 内部使用（升级时调用）
        "")             show_menu ;;
        *)              log_error "未知命令：$1"; cmd_help; exit 1 ;;
    esac
}

main "$@"
