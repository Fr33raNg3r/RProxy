[Unit]
Description=RProxy WebUI Management Panel
After=network.target
# 启动频率限制必须写在 [Unit]，写在 [Service] 会被 systemd 忽略
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
ExecStart=/opt/rproxy-gw/bin/webui serve
WorkingDirectory=/opt/rproxy-gw
Restart=on-failure
RestartSec=5s
# WebUI 需要执行 systemctl / nft / wg 等命令，故以 root 运行
User=root
Group=root
# 但仍开启基础保护
NoNewPrivileges=false
ProtectSystem=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
