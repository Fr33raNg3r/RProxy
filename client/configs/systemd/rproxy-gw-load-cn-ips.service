[Unit]
Description=RProxy Load GeoIP-CN into nftables cn_ips set
After=nftables.service rproxy-gw-iproute.service
Requires=nftables.service
ConditionPathExists=/opt/rproxy-gw/data/geo/geoip-cn.txt

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/rproxy-gw/scripts/load-cn-ips.sh

[Install]
WantedBy=multi-user.target
